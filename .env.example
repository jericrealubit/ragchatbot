# Copy to .env and fill in both keys.
# .env is gitignored.

# Groq Cloud API key — https://console.groq.com/keys  (format: gsk_...)
GROQ_API_KEY=

# SerpAPI key for live Google search — https://serpapi.com/manage-api-key
# Free tier: 100 searches/month. Optional: without it, PDF RAG still works
# but the live-web-search path returns a disabled notice.
SERPAPI_API_KEY=
